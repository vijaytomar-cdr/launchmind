{
  "name": "launchmind-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/launchmind-dev.mjs --mode=real",
    "dev:morning-brief-demo": "node scripts/launchmind-dev.mjs --mode=demo",
    "dev:isolated": "node scripts/launchmind-dev.mjs --mode=real --isolated --port=3002 --dist-dir=.next-dev-3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:backend": "npm --prefix backend run test",
    "test:integration": "npm --prefix backend run test:integration",
    "test:providers": "npm --prefix backend run test:providers",
    "test:security": "npm --prefix backend run test:security",
    "test:isolation": "npm --prefix backend run test:isolation",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "npm --prefix backend run type-check",
    "lint:backend": "npm --prefix backend run lint",
    "build:backend": "npm --prefix backend run build",
    "verify": "npm run typecheck && npm run typecheck:backend && npm run lint && npm run lint:backend && npm run build:backend && npm run build:verify && npm run test && npm run test:backend",
    "test:vault": "npm --prefix backend run test:vault",
    "oci:check": "node scripts/check-oci-vault.mjs",
    "pgdb:up": "supabase start --workdir .pgcert",
    "pgdb:down": "supabase stop --workdir .pgcert",
    "pgdb:reset": "supabase db reset --workdir .pgcert",
    "pgdb:migrate": "bash scripts/pgdb-migrate.sh",
    "pgdb:mark": "bash scripts/pgdb-mark.sh PG_INTEGRATION .pgcert",
    "staging:mark": "bash scripts/pgdb-mark.sh BROWSER_CERT .",
    "staging:up": "supabase start && docker start lm-redis-staging 2>/dev/null || docker run -d --name lm-redis-staging -p 6380:6379 redis:7-alpine",
    "staging:down": "supabase stop && docker stop lm-redis-staging",
    "staging:migrate": "bash scripts/staging-migrate.sh",
    "staging:seed": "node --env-file=.env.staging scripts/staging-seed.mjs",
    "staging:reset": "node --env-file=.env.staging scripts/staging-reset.mjs",
    "staging:verify": "node --env-file=.env.staging scripts/staging-verify.mjs",
    "staging:dev": "bash scripts/staging-frontend.sh",
    "build:verify": "NEXT_DIST_DIR=.next-build next build",
    "cert:browser:guard": "node --env-file=.env.staging scripts/browser-cert-guard.mjs",
    "cert:browser": "npm run cert:browser:guard && node --env-file=.env.staging node_modules/.bin/playwright test --project=cert tests/e2e/market-intelligence.cert.spec.ts",
    "test:b5:dev-browser:guard": "node --env-file=.env.local tests/e2e-dev/dev-smoke-guard.mjs",
    "test:b5:dev-browser": "LM_ENV_MODE=LOCAL_REAL_DEVELOPMENT npm run test:b5:dev-browser:guard && LM_ENV_MODE=LOCAL_REAL_DEVELOPMENT node --env-file=.env.local node_modules/.bin/playwright test --project=dev-smoke"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.0",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.378.0",
    "next": "^14.2.35",
    "posthog-js": "^1.131.0",
    "qrcode.react": "^3.1.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "ws": "^8.20.1"
  }
}
