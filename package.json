{
  "name": "launchmind-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:backend": "npm --prefix backend run test",
    "test:integration": "npm --prefix backend run test:integration",
    "test:providers": "npm --prefix backend run test:providers",
    "test:security": "npm --prefix backend run test:security",
    "test:isolation": "npm --prefix backend run test:isolation",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "npm --prefix backend run type-check",
    "lint:backend": "npm --prefix backend run lint",
    "build:backend": "npm --prefix backend run build",
    "verify": "npm run typecheck && npm run typecheck:backend && npm run lint && npm run lint:backend && npm run build:backend && npm run test && npm run test:backend",
    "test:vault": "npm --prefix backend run test:vault",
    "oci:check": "node scripts/check-oci-vault.mjs",
    "staging:up": "supabase start && docker start lm-redis-staging 2>/dev/null || docker run -d --name lm-redis-staging -p 6380:6379 redis:7-alpine",
    "staging:down": "supabase stop && docker stop lm-redis-staging",
    "staging:migrate": "bash scripts/staging-migrate.sh",
    "staging:seed": "node --env-file=.env.staging scripts/staging-seed.mjs",
    "staging:reset": "node --env-file=.env.staging scripts/staging-reset.mjs",
    "staging:verify": "node --env-file=.env.staging scripts/staging-verify.mjs",
    "staging:dev": "bash scripts/staging-frontend.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.0",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.378.0",
    "next": "^14.2.35",
    "posthog-js": "^1.131.0",
    "qrcode.react": "^3.1.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "ws": "^8.20.1"
  }
}
