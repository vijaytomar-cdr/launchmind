# Variable NAMES only. No values, no credential-shaped placeholders.
#
# Deployed LaunchMind resolves every one of these from a Key Vault / secret
# manager at boot. This file exists so the required set is discoverable; it is
# NOT loaded by anything and a real .env.prod is deliberately not supported.
# See docs/environment-contract.md §C.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Model providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ── Queue and cache ─────────────────────────────────────────────────────────
REDIS_URL=

# ── Payments ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Provider integrations (Improve Intelligence) ────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_APP_ID=
META_APP_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=

# ── Creative providers (Phase 3.5B6+ — NOT called in 3.5B3) ─────────────────
# Server-side only. NEVER expose through NEXT_PUBLIC_*, never log the value.
# Local real-development supplies this from .env.local (gitignored); deployed
# production resolves it from the Key Vault / secret manager (see §C).
#
# Avatar and voice selection are DELIBERATELY ABSENT here. They are governed
# product/content creative configuration — different owners and different
# products use different avatars and voices — so they belong to a content
# record, not to a process-wide environment variable.
HEYGEN_API_KEY=
HEYGEN_API_BASE_URL=https://api.heygen.com

# ── Encryption ──────────────────────────────────────────────────────────────
AWS_KMS_KEY_ID=
AWS_REGION=

# ── Email and observability ─────────────────────────────────────────────────
RESEND_API_KEY=
SENTRY_DSN=
AXIOM_TOKEN=

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=
MORNING_BRIEF_DEMO_DATA=false
API_URL=
NODE_ENV=

# Search demand (server only): add your private SerpApi key to enable provider access.
SERPAPI_API_KEY=
MARKET_INTELLIGENCE_MODE=ACTIVE
