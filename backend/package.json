{
  "name": "launchmind-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "supabase migration up --local",
    "db:migrate:remote": "supabase db push",
    "db:reset": "supabase db reset --local",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --exclude 'tests/**/*.pg.test.ts'",
    "test:integration": "vitest run tests/workspaceSignalDedup.pg.test.ts tests/memoryWorkspaceScope.pg.test.ts tests/embeddingOutbox.pg.test.ts tests/retrievalSql.pg.test.ts",
    "test:providers": "vitest run tests/appStoreConnect.test.ts tests/appStoreConnectJourney.test.ts tests/observationProviders.test.ts tests/observationProviderJourneys.test.ts tests/paidPlatforms.test.ts tests/lifecycleProviders.test.ts",
    "test:security": "vitest run tests/connectionSecurity.test.ts tests/executionBoundary.test.ts tests/credentialVault.test.ts",
    "test:isolation": "vitest run tests/workspaceIsolation.test.ts tests/connections.test.ts tests/connectionStateMachine.test.ts",
    "db:test:up": "docker run -d --name lm-pg-test -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=launchmind_test -p 55432:5432 pgvector/pgvector:pg16",
    "db:test:down": "docker rm -f lm-pg-test",
    "test:vault": "vitest run tests/vaultRoundTrip.live.test.ts",
    "kms:local:up": "docker run -d --name lm-kms -e SERVICES=kms -p 4566:4566 localstack/localstack:3",
    "kms:local:down": "docker rm -f lm-kms",
    "dev:staging": "tsx watch --env-file=../.env.staging src/server.ts",
    "eval:retrieval": "tsx tests/evals/memory-retrieval/runBaseline.ts",
    "embeddings:backfill": "tsx scripts/embeddingBackfill.cli.ts",
    "memory:retrieve": "tsx scripts/memoryRetrieve.cli.ts",
    "context:shadow": "tsx scripts/contextShadowCompare.ts",
    "eval:heldout": "tsx --env-file=../.env.local tests/evals/memory-retrieval/runHeldOut.ts",
    "eval:comparison": "tsx --env-file=../.env.local scripts/liveClaimComparison.ts",
    "shadow:validate": "tsx --env-file=../.env.local scripts/shadowValidation.ts",
    "eval:acquire-embeddings": "tsx --env-file=../.env.local scripts/acquireEvalEmbeddings.ts",
    "shadow:observe": "tsx --env-file=../.env.local scripts/shadowObservation.ts",
    "eval:acquire-corpus": "tsx --env-file=../.env.local scripts/acquireCorpusEmbeddings.ts",
    "eval:acquire-relation-queries": "tsx --env-file=../.env.local scripts/acquireRelationQueries.ts",
    "eval:acquire-canva-queries": "tsx --env-file=../.env.local scripts/acquireCanvaQueries.ts",
    "cert:canva-local": "tsx --env-file=../.env.local scripts/canvaLocalCertification.ts",
    "eval:acquire-qual": "tsx --env-file=../.env.local scripts/acquireQualQueries.ts",
    "test:pg": "node scripts/pgCertify.mjs",
    "test:pg:prelaunch": "node scripts/pgCertify.mjs --prelaunch",
    "eval:qualitative": "tsx --env-file=../.env.local scripts/qualitativeEvaluation.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.21.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.43.0",
    "app-store-scraper": "^0.18.0",
    "bullmq": "^5.7.0",
    "cheerio": "^1.0.0",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "google-play-scraper": "^10.1.2",
    "ioredis": "^5.3.2",
    "jose": "^5.10.0",
    "oci-common": "^2.139.0",
    "oci-keymanagement": "^2.139.0",
    "playwright": "^1.44.0",
    "razorpay": "^2.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^3.2.0",
    "sharp": "^0.35.3",
    "stripe": "^22.1.1",
    "ws": "^8.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
